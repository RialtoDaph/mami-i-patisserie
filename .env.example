# Copy this file to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only (never NEXT_PUBLIC_): Supabase secret key (Project Settings → API Keys). Needed for the PIN login
# on registered devices and for adding team members in Akun tim. Without it only the email login works.
SUPABASE_SECRET_KEY=

# Public website
NEXT_PUBLIC_SITE_URL=https://mami-i-patisserie.vercel.app
# WhatsApp number for orders (e.g. 0812-3456-7890 or 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Instagram handle without @
NEXT_PUBLIC_INSTAGRAM=
# Set to 1 only on previews to show [DUMMY] products on the public site
NEXT_PUBLIC_SHOW_DUMMY=
